#!/bin/sh
# --- MT7981 物理主權 v8.5 (四合一模式·全量對齊版) ---

# 1. 喚醒硬件模組
modprobe crypto_safexcel 2>/dev/null
echo 1 > /proc/sys/net/netfilter/nf_flow_table_hw 2>/dev/null

# 2. 核心對等化：IRQ 交錯分配 (MT7981 專屬邏輯)
# ---------------------------------------------------------
ETH_IRQ=$(grep -m1 "mtk-network" /proc/interrupts | cut -d: -f1 | tr -d ' ')
WIFI_IRQ=$(grep -m1 "mt7981" /proc/interrupts | cut -d: -f1 | tr -d ' ')
CRYPTO_IRQ=$(grep "eip" /proc/interrupts | cut -d: -f1)

# 有線/中繼分流至 CPU0
[ -n "$ETH_IRQ" ] && echo 1 > "/proc/irq/$ETH_IRQ/smp_affinity"
# 加密引擎回歸 CPU0 (與有線對齊，騰出 CPU1 處理無線)
for irq in $CRYPTO_IRQ; do echo 1 > "/proc/irq/$irq/smp_affinity"; done
# 無線流量鎖定在 CPU1
[ -n "$WIFI_IRQ" ] && echo 2 > "/proc/irq/$WIFI_IRQ/smp_affinity"

# 3. RPS 四合一邏輯：全量開啟溢出緩衝
for rps_file in /sys/class/net/*/queues/rx-*/rps_cpus; do echo 3 > "$rps_file"; done
for rps_flow in /sys/class/net/*/queues/rx-*/rps_flow_cnt; do echo 1024 > "$rps_flow"; done
echo 4096 > /proc/sys/net/core/rps_sock_flow_entries

# 4. 系統級內核調優 (融合 B+C 模塊)
# ---------------------------------------------------------
cat >> /etc/sysctl.conf <<EOF
# A53 心跳優化：縮短調度週期
kernel.sched_latency_ns=8000000
kernel.sched_min_granularity_ns=1000000
kernel.sched_wakeup_granularity_ns=1500000

# 網絡吞吐與 BBR
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=bbr
net.core.netdev_budget=1000
net.core.netdev_budget_usecs=10000

# 內存管理 (防爆、防抖)
vm.vfs_cache_pressure=40
vm.min_free_kbytes=20480

# TCP 窗口與緩衝區 (針對 4K 影音)
net.core.rmem_max=16777216
net.core.wmem_max=16777216
net.ipv4.tcp_rmem=4096 87380 16777216
net.ipv4.tcp_wmem=4096 65536 16777216
EOF
sysctl -p

# 5. CPU 頻率定頻效能模式
for i in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > "$i/scaling_governor"; done

# 6. zRAM 強制 zstd 重構 (內存物理增程)
if [ -b /dev/zram0 ]; then
    swapoff /dev/zram0 2>/dev/null
    echo 1 > /sys/block/zram0/reset 2>/dev/null
    echo zstd > /sys/block/zram0/comp_algorithm
    TOTAL_MEM=$(free | grep Mem | awk '{print $2}')
    echo $((TOTAL_MEM * 1024)) > /sys/block/zram0/disksize
    mkswap /dev/zram0 >/dev/null
    swapon -p 10 /dev/zram0
fi

# 7. 加載硬件引擎與 PPE
modprobe crypto_safexcel 2>/dev/null
echo 1 > /proc/sys/net/netfilter/nf_flow_table_hw 2>/dev/null

# 8. 物理內存保護 (全局定值，消除機型衝突)
# 統一設置為 20MB，確保超頻後 DMA 不斷流，這是最穩妥的底線
sysctl -w vm.min_free_kbytes=20480

# 9. 強制執行定頻效能模式 (確保 1.6G+ 滿血運行)
for i in /sys/devices/system/cpu/cpufreq/policy*; do echo performance > "$i/scaling_governor"; done

exit 0
