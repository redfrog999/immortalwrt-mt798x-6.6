#!/bin/sh
# --- MT7981 物理主權 v7.0 (穩定中繼·終極修正) ---

logger -t "Sovereignty" "開始執行 v7.0：撤回中繼硬加速，保留物理消噪與優化"
sleep 5

# 1. 核心分工：IRQ 物理隔離 (不變，這是冷靜運行的根基)
# ---------------------------------------------------------
ETH_IRQ=$(grep -m1 "mtk-network" /proc/interrupts | cut -d: -f1 | tr -d ' ')
WIFI_IRQ=$(grep -m1 "mt7981" /proc/interrupts | cut -d: -f1 | tr -d ' ')
CRYPTO_IRQ=$(grep "eip" /proc/interrupts | cut -d: -f1)

[ -n "$ETH_IRQ" ] && echo 1 > "/proc/irq/$ETH_IRQ/smp_affinity"
[ -n "$WIFI_IRQ" ] && echo 2 > "/proc/irq/$WIFI_IRQ/smp_affinity"
for irq in $CRYPTO_IRQ; do echo 2 > "/proc/irq/$irq/smp_affinity"; done

# 2. 軟分流回歸 (RPS)：解決中繼不穩的特效藥
# ---------------------------------------------------------
# 既然 HNAT 不吃中繼包，我們就用 RPS 讓 CPU1 專門伺候無線流量
for dev_path in /sys/class/net/*; do
    dev=$(basename "$dev_path")
    [ "$dev" = "lo" ] && continue
    # 無線接口 (ra/wlan/apcli) 分配給 CPU1 (掩碼 2)
    if echo "$dev" | grep -Eq 'ra|wlan|apcli'; then
        for rps_file in "$dev_path"/queues/rx-*/rps_cpus; do
            echo 2 > "$rps_file"
        done
    # 有線接口 (eth/wan/lan) 分配給 CPU0 (掩碼 1)
    elif echo "$dev" | grep -Eq 'eth|wan|lan'; then
        for rps_file in "$dev_path"/queues/rx-*/rps_cpus; do
            echo 1 > "$rps_file"
        done
    fi
done

# 3. 基因加速與聚合 (ethtool)：保留，降溫核心
# ---------------------------------------------------------
for eth in $(ls /sys/class/net | grep -E 'eth|wan|lan'); do
    ethtool -K "$eth" gro on gso on tso on 2>/dev/null
    ethtool -C "$eth" rx-usecs 100 tx-usecs 100 2>/dev/null
done

# 4. 物理消噪：讓 GFW 摸不到底 (全部保留)
# ---------------------------------------------------------
cat >> /etc/sysctl.conf <<EOF
# 忽略廣播與偽造錯誤響應
net.ipv4.icmp_echo_ignore_broadcasts=1
net.ipv4.icmp_ignore_bogus_error_responses=1
# 限制響應頻率，防探測掃描
net.ipv4.icmp_ratelimit=100
# 縮短超時，快進快出，不留殘骸
net.ipv4.tcp_fin_timeout=15
net.ipv4.tcp_fastopen=3
# TCP 窗口縮放與擁塞控制
net.ipv4.tcp_window_scaling=1
net.core.default_qdisc=fq_codel
net.ipv4.tcp_congestion_control=bbr
EOF

# 5. 內存去重與內功調理 (KSM/zRAM)
# ---------------------------------------------------------
if [ -f /sys/kernel/mm/ksm/run ]; then
    echo 1 > /sys/kernel/mm/ksm/run
    echo 100 > /sys/kernel/mm/ksm/pages_to_scan
    echo 20 > /sys/kernel/mm/ksm/sleep_millisecs
fi

# 6. NFTables：遊戲優先規則
# ---------------------------------------------------------
nft insert rule inet fw4 mangle_postrouting udp dport { 1024-65535 } udp length 0-128 ip dscp set ef 2>/dev/null
# 屏蔽低 TTL 探測包 (GFW 常用探測手段)
nft insert rule inet fw4 input ip protocol icmp icmp type echo-request ip ttl lt 5 counter drop 2>/dev/null

# 7. 進程優先級微調
# ---------------------------------------------------------
for proc in hysteria xray ss-local smartdns; do
    pids=$(pgrep $proc)
    [ -n "$pids" ] && for pid in $pids; do renice -n -10 $pid; done
done

sysctl -p
logger -t "Sovereignty" "v7.0 部署完畢：中繼已修復，消噪已開啟。"
exit 0
